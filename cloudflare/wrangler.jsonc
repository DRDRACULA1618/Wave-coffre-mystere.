{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wave-coffre-service",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name": "SESSIONS", "class_name": "GameSession"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GameSession"]}],
  "vars": {"ALLOWED_ORIGIN": "https://drdracula1618.github.io"}
}
